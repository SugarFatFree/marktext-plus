<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="text/markdown">
    <comment>Markdown document</comment>
    <comment xml:lang="zh_CN">Markdown 文档</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.markdown"/>
    <glob pattern="*.mdown"/>
    <glob pattern="*.mkdn"/>
    <glob pattern="*.md"/>
    <glob pattern="*.mkd"/>
    <glob pattern="*.mdwn"/>
    <glob pattern="*.mdtxt"/>
    <glob pattern="*.mdtext"/>
    <glob pattern="*.mdx"/>
    <glob pattern="*.mmd"/>
    <!--
      `.text` and `.txt` are deliberately absent, though the editor opens both
      and `FileUtils.markdownExtensions` lists them. A glob here does not say
      "this application can open the file", it says "a file with this name IS
      text/markdown" — system-wide, for every application. Claiming `*.txt`
      would retype every plain text file on the machine.
    -->
  </mime-type>
</mime-info>
